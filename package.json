{
  "name": "eventpipe-ds",
  "version": "0.1.0",
  "private": true,
  "description": "A themed Quasar component library, documented and QA'd in Storybook.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "dev:prototype": "vite --config vite.prototype.config.js --port 6007",
    "build:prototype": "vite build --config vite.prototype.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stories": "node scripts/smoke-stories.mjs",
    "verify": "pnpm lint && pnpm test && pnpm build-storybook"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@quasar/extras": "^1.16.12",
    "chart.js": "^4.5.1",
    "quasar": "^2.17.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/vite-plugin": "^1.9.0",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/vue3-vite": "^10.4.6",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "remark-gfm": "^4.0.1",
    "sass-embedded": "^1.83.0",
    "storybook": "^10.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
